<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>MediPredict - Evaluación de Síntomas</title>
  <link rel="stylesheet" href="/resources/css/style.css" />
</head>
<body>
  <header class="header">
    <div class="logo"> <a href="/" style="text-decoration: none; color: inherit;">MediPredict</a> </div>
    <button class="mode-toggle" onclick="toggleDarkMode()">Modo Noche</button>
  </header>

  <div class="container">
    <h2>Formulario de Triaje</h2>
    <form method="POST" action="/DoTriaje">

      <!-- ID -->
      <div class="form-group" style="display: none;">
        <label for="id_paciente">ID del Paciente</label>
        <input type="number" name="Id_Paciente" id="id_paciente" value="<%= Id_Paciente %>" />
      </div>


      <!-- Modo LLegada -->
      <div class="form-group">
        <label for="modo_llegada">Modo de Llegada</label>
        <select name="Modo_LLegada" id="modo_llegada" required>
          <option value="">Seleccione</option>
          <option value="1">Caminando</option>
          <option value="2">Servicio de Emergencia</option>
          <option value="3">Vehiculo Privado</option>
          <option value="5">Transporte Publico</option>
          <option value="6">Silla de Ruedas</option>
          <option value="7">Otro</option>
        </select>
      </div>

      <!-- Lesion -->
      <div class="form-group">
        <label for="lesion">¿Tiene lesión visible?</label>
        <select name="Lesion" id="lesion" required>
          <option value="">Seleccione</option>
          <option value="2">Sí</option>
          <option value="1">No</option>
        </select>
      </div>

      <!-- Queja -->
      <div class="form-group">
        <label for="queja">Queja Principal</label>
        <textarea name="Queja_Principal" id="queja" rows="3" required></textarea>
      </div>

      <!-- Estado Mental -->
      <div class="form-group">
        <label for="estado_mental">Estado Mental</label>
        <select name="Estado_Mental" id="estado_mental" required>
          <option value="">Seleccione</option>
          <option value="1">Alerta</option>
          <option value="2">Reaccion Verbal</option>
          <option value="3">Reaccion al Dolor</option>
          <option value="4">Inconsciente</option>
        </select>
      </div>

      <!-- Dolor -->
      <div class="form-group">
        <label for="dolor">¿Tiene Dolor?</label>
        <select name="Dolor" id="dolor" required>
          <option value="">Seleccione</option>
          <option value="1">Sí</option>
          <option value="2">No</option>
        </select>
      </div>

      <!-- Escala Dolor -->
      <div class="form-group">
        <label for="escala_dolor">Escala del Dolor (1-10)</label>
        <input type="number" name="Escala_Dolor" id="escala_dolor" min="0" max="10" />
      </div>

      <!-- Presion Sistolica -->
      <div class="form-group">
        <label for="presion_sistolica">Presión Sistólica (mmHg)</label>
        <input type="number" name="Presion_Sistolica" id="presion_sistolica" />
      </div>

      <!-- Presion Diastolica -->
      <div class="form-group">
        <label for="presion_diastolica">Presión Diastólica (mmHg)</label>
        <input type="number" name="Presion_Diastolica" id="presion_diastolica" />
      </div>

      <!-- Frecuencia Cardiaca -->
      <div class="form-group">
        <label for="frecuencia_cardiaca">Frecuencia Cardíaca (lpm)</label>
        <input type="number" name="Frecuencia_Cardiaca" id="frecuencia_cardiaca" />
      </div>

      <!-- Frecuencia Respiratoria -->
      <div class="form-group">
        <label for="frecuencia_respiratoria">Frecuencia Respiratoria (rpm)</label>
        <input type="number" name="Frecuencia_Respiratoria" id="frecuencia_respiratoria" />
      </div>

      <!-- Temperatura Corporal -->
      <div class="form-group">
        <label for="temperatura">Temperatura Corporal (°C)</label>
        <input type="number" step="0.1" name="Temperatura_Corporal" id="temperatura" />
      </div>
      <!-- Saturacion Oxigeno -->
      <div class="form-group">
        <label for="Saturacion">Saturacion de Oxigeno(O2)</label>
        <input type="number" step="1" name="Saturacion" id="Saturacion" />
      </div>

      <!-- Grupo -->
      <div class="form-group">
        <label for="Type_ED">Tipo de ED</label>
        <select name="Type_ED" id="Type_ED" required>
          <option value="">Seleccione</option>
          <option value="2">Rural</option>
          <option value="1">Local</option>
        </select>
      </div>
      
      
      <button type="submit" class="btn">Clasificar</button>
    </form>
  </div>

