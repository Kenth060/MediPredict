  </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <% if (typeof alert != "undefined") { %>
    <script>
      Swal.fire({
        title: "<%= alertTitle %>",
        text: "<%= alertMessage %>",
        icon: "<%= alertIcon %>",
        showConfirmButton: true,
        timer: false,
      }).then(() => {
        window.location = "/<%= ruta %>";
      });
    </script>
    <% } %>
  

    <script>
      function toggleDarkMode() 
      { document.body.classList.toggle('dark-mode'); }
    
    </script>
</body>
</html>
